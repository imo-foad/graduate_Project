# Names only. Never commit real values. Service role key and DEMO_PASSWORD are SERVER-SIDE ONLY (never in Android/APK).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<publishable/anon key - safe for the Android client>
SUPABASE_SERVICE_ROLE_KEY=<secret - provisioning script and Edge Functions only>
DEMO_PASSWORD=<min 12 chars, chosen by the team>
# Registration/identity (server-side Edge Function secrets; never commit values).
NATIONAL_ID_HMAC_SECRET=<min 32 random chars - keyed digest, never a plain hash>
IDENTITY_PROVIDER_MODE=<http|mock>
IDENTITY_PROVIDER_URL=<https://institution.example/api/verify>
IDENTITY_PROVIDER_TOKEN=<institutional API token>
ALLOW_MOCK_IDENTITY=<true only in disposable local tests, otherwise false>
